# ==============================================================================
# Machine 2: nginx Configuration Template
# Computer Networks Course Project - Private Network Service Platform
#
# Roles:
# 1. Edge Reverse Proxy
# 2. Layer 7 Load Balancer (Round-Robin between Backend A & B)
# 3. TLS / HTTPS Termination for app.team1.test and api.team1.test
# 4. HTTP-to-HTTPS Redirection (Port 80 -> 443)
# 5. Reverse Proxy Caching (Cache-Control: max-age=60)
#
# IMPORTANT:
# Replace IP addresses, paths, and certificate paths with your machine's layout.
# ==============================================================================

# Worker processes (auto sets number of CPU cores)
worker_processes auto;
pid /tmp/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Logging format: Captures client IP, TLS protocol/cipher, upstream chosen, and cache status
    log_format custom_combined '$remote_addr - $remote_user [$time_local] '
                               '"$request" $status $body_bytes_sent '
                               '"$http_referer" "$http_user_agent" '
                               'ssl="$ssl_protocol/$ssl_cipher" '
                               'upstream="$upstream_addr" '
                               'upstream_status="$upstream_status" '
                               'cache="$upstream_cache_status"';

    access_log /var/log/nginx/access.log custom_combined;

    sendfile        on;
    tcp_nopush     on;
    tcp_nodelay    on;
    keepalive_timeout  65;

    # --------------------------------------------------------------------------
    # 1. Reverse Proxy Cache Configuration
    # --------------------------------------------------------------------------
    # Allocates a 10MB shared memory zone (STATIC_CACHE) to store cache keys.
    # Cached payload files are stored under the specified disk path.
    # Note: On macOS with Homebrew, you may adjust path to /opt/homebrew/var/cache/nginx
    proxy_cache_path /tmp/nginx_cache
                     levels=1:2
                     keys_zone=STATIC_CACHE:10m
                     max_size=100m
                     inactive=60m
                     use_temp_path=off;

    # --------------------------------------------------------------------------
    # 2. Upstream Backend Pool (Layer 7 Round-Robin Load Balancer)
    # --------------------------------------------------------------------------
    # Default algorithm in nginx upstream is Round-Robin.
    # Requests alternate sequentially between Backend A and Backend B.
    upstream backend_pool {
        # Backend A - Machine 3 (Example: 10.7.3.22:3001)
        # [CHANGE THIS if Machine 3 IP or Port changes]
        server 10.7.3.22:3001 max_fails=3 fail_timeout=10s;

        # Backend B - Machine 4 (Example: 10.7.11.17:3002)
        # [CHANGE THIS if Machine 4 IP or Port changes]
        server 10.7.11.17:3002 max_fails=3 fail_timeout=10s;

        # Keepalive connections to upstreams for improved throughput
        keepalive 32;
    }

    # --------------------------------------------------------------------------
    # 3. HTTP Server Block (Port 80) -> Force Redirect to HTTPS (Port 443)
    # --------------------------------------------------------------------------
    server {
        listen 80;
        listen [::]:80;
        server_name app.team1.test api.team1.test;

        # Enforce secure transmission via HTTP 301 Permanent Redirect
        return 301 https://$host$request_uri;
    }

    # --------------------------------------------------------------------------
    # 4. HTTPS Server Block (Port 443) - TLS Termination & Reverse Proxy
    # --------------------------------------------------------------------------
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name app.team1.test api.team1.test;

        # --- TLS / SSL Certificate Configuration ---
        # NOTE: Do NOT commit private keys to git. Use absolute paths to local certs.
        # Generated via mkcert or openssl with SAN: app.team1.test, api.team1.test
        ssl_certificate     /opt/homebrew/etc/nginx/certs/team1.test.crt;
        ssl_certificate_key /opt/homebrew/etc/nginx/certs/team1.test.key;

        # --- TLS Hardening & Security Protocols ---
        # Allow only modern, secure protocols (TLS 1.2 and TLS 1.3)
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        # Security Headers
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;

        # Expose Load Balancer and Cache diagnostics in response headers
        add_header X-Served-By "nginx-edge-machine2" always;
        add_header X-Cache-Status $upstream_cache_status always;

        # ----------------------------------------------------------------------
        # Location: /api/ - Dynamic Reverse Proxy & Load Balancing
        # ----------------------------------------------------------------------
        location /api/ {
            # Forward traffic to the upstream round-robin pool
            proxy_pass http://backend_pool;

            # HTTP 1.1 for keepalive upstream support
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            # Preserve client and host identification across reverse proxy hop
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Timeouts
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
            proxy_read_timeout 10s;

            # Pass through the custom X-Backend header returned by Node.js backends
            proxy_pass_header X-Backend;
        }

        # ----------------------------------------------------------------------
        # Location: /cached/ - Caching Demonstration Endpoint
        # Demonstrates HTTP Caching (Cache-Control max-age=60)
        # ----------------------------------------------------------------------
        location /cached/ {
            # Proxy to backend status endpoint internally
            rewrite ^/cached/(.*) /api/$1 break;
            proxy_pass http://backend_pool;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Enable proxy caching
            proxy_cache STATIC_CACHE;
            proxy_cache_key "$scheme$request_method$host$request_uri";
            proxy_cache_valid 200 302 60s;
            proxy_cache_valid 404 10s;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

            # Inject HTTP 60-second client cache header
            add_header Cache-Control "public, max-age=60";
            add_header X-Cache-Status $upstream_cache_status always;
            add_header X-Served-By "nginx-edge-machine2" always;
            proxy_pass_header X-Backend;
        }

        # ----------------------------------------------------------------------
        # Location: / - Root Location
        # ----------------------------------------------------------------------
        location / {
            proxy_pass http://backend_pool;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_pass_header X-Backend;
        }
    }
}
